{
    "useTabs": true,
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "overrides": [
        {
            "files": "*.tsx",
            "options": {
                "parser": "typescript",
                "useTabs": true,
                "tabWidth": 4
            }
        }
    ]
}
